# Copy this file to .env and fill in real values. Never commit .env.

# Supabase -- Project Settings > API. The SERVICE ROLE key bypasses RLS and
# can read every résumé and every applicant record: keep it out of git,
# never paste it into chat/tickets, and only run this tool from a machine
# you trust.
SUPABASE_URL=https://pjopugzttogtpgtcsgbo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Entra (Azure AD) app registration -- see README.md for the
# exact steps. Only the Client ID is needed (public client / device code
# flow, no client secret).
ONEDRIVE_CLIENT_ID=
# "consumers" for a personal Microsoft/OneDrive account (default),
# "organizations" for OneDrive for Business/a work or school account,
# or a specific tenant ID/domain.
ONEDRIVE_TENANT=consumers

# Root folder created under the signed-in account's OneDrive root.
ONEDRIVE_ROOT_FOLDER=RecruitmentBackups

# Comma-separated list of which applicant document columns to back up.
# Options: resume, degree, training, other
BACKUP_FILE_KINDS=resume
